{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresDb": "Host=PostgresDB;Port=5432;Database=o2connect;Username=o2connect;Password=o2connect"
  },
  "Api": {
    "Domain": "https://auth.example.com"
  },
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "Host=PostgresDB;Port=5432;Database=o2connect;Username=o2connect;Password=o2connect"
  },
  "Features": {
    "EnableDynamicClientRegistration": true,
    "EnableDeviceFlow": true,
    "EnableRevocationEndpoint": true
  },
  "Jwt": {
    "Issuer": "https://auth.example.com",
    "Audience": "api",
    "AccessTokenLifetimeSeconds": 3600,
    "RefreshTokenLifetimeDays": 30,
    "Signing": {
      "KeyId": "main-key",
      "PrivateKeyPath": "keys/private.pem",
      "PublicKeyPath": "keys/public.pem"
    }
  },
  "OAuth": {
    "RequirePkce": true,
    "AllowPlainPkce": false,
    "AllowRefreshTokenReuse": false,
    "RotateRefreshTokens": true,
    "ReuseDetectionEnabled": true
  },
  "Oidc": {
    "Issuer": "https://auth.example.com",
    "AuthorizationEndpoint": "/connect/authorize",
    "TokenEndpoint": "/connect/token",
    "UserInfoEndpoint": "/connect/userinfo",
    "JwksEndpoint": "/.well-known/jwks.json",
    "EndSessionEndpoint": "/connect/logout",
    "ScopesSupported": [
      "openid",
      "profile",
      "email"
    ],
    "ResponseTypesSupported": [
      "code"
    ]
  },
  "Security": {
    "Password": {
      "MinLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 15
    }
  },
  "DiscoveryEndpoints": {
    "Documentation": "https://auth.example.com/docs/oidc",
    "PrivacyPolicy": "https://auth.example.com/policy",
    "TermsOfService": "https://auth.example.com/terms"
  }
}
