{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "https://auth.your-domain.com",
        "ActiveKeyId": "rsa-key-2026-01",
        "AccessTokenLifetimeSeconds": 3600,
        "KeyRotation": {
            "Enabled": true,
            "RotationIntervalDays": 30,
            "RetainOldKeysForDays": 90
        }
    },
    "OAuth": {
        "TokenEndpoint": "https://your-domain/connect/token"
    }
}
