{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "Domain": "https://api.your-domain.com"
  },
  "Jwt": {
    "Issuer": "https://auth.your-domain.com",
    "ActiveKeyId": "rsa-key-2026-01",
    "AccessTokenLifetimeSeconds": 3600,
    "KeyRotation": {
      "Enabled": true,
      "RotationIntervalDays": 30,
      "RetainOldKeysForDays": 90
    }
  },
  "OAuth": {
    "TokenEndpoint": "https://your-domain/connect/token"
  },
  "DiscoveryEndpoints": {
    "Documentation": "https://your-domain.com/docs/oidc",
    "PrivacyPolicy": "https://your-domain.com/policy",
    "TermsOfService": "https://your-domain.com/terms"
  }
}
