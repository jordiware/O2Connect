{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Issuer": "https://example.com",
        "SigningKey": "super-secret-key-123456",
        "AccessTokenLifetimeSeconds": 3600
    },
