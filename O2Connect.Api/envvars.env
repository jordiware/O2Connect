# Environment
ASPNETCORE_ENVIRONMENT=Development

# Connection Strings
ConnectionStrings__PostgresDb=Host=PostgresDB;Port=5432;Database=o2connect;Username=o2connect;Password=o2connect

# Database
Database__Provider=Postgres
Database__ConnectionString=Host=PostgresDB;Port=5432;Database=o2connect;Username=o2connect;Password=o2connect

# API
Api__Domain=https://auth.example.com

# Features
Features__EnableDynamicClientRegistration=true
Features__EnableDeviceFlow=true
Features__EnableRevocationEndpoint=true

# JWT
Jwt__Issuer=https://auth.example.com
Jwt__Audience=api
Jwt__AccessTokenLifetimeSeconds=3600
Jwt__RefreshTokenLifetimeDays=30
Jwt__Signing__KeyId=main-key
Jwt__Signing__PrivateKeyPath=private_key.pem
Jwt__Signing__PublicKeyPath=public_key.pem

# OAuth
OAuth__RequirePkce=true
OAuth__AllowPlainPkce=false
OAuth__AllowRefreshTokenReuse=false
OAuth__RotateRefreshTokens=true
OAuth__ReuseDetectionEnabled=true

# OIDC
Oidc__Issuer=https://auth.example.com
Oidc__AuthorizationEndpoint=/connect/authorize
Oidc__TokenEndpoint=/connect/token
Oidc__UserInfoEndpoint=/connect/userinfo
Oidc__JwksEndpoint=/.well-known/jwks.json
Oidc__EndSessionEndpoint=/connect/logout

Oidc__ScopesSupported__0=openid
Oidc__ScopesSupported__1=profile
Oidc__ScopesSupported__2=email

Oidc__ResponseTypesSupported__0=code

# Security - Password
Security__Password__MinLength=8
Security__Password__RequireUppercase=true
Security__Password__RequireLowercase=true
Security__Password__RequireDigit=true
Security__Password__RequireNonAlphanumeric=false

# Security - Lockout
Security__Lockout__MaxFailedAttempts=5
Security__Lockout__DurationMinutes=15

# Discovery
DiscoveryEndpoints__Documentation=https://auth.example.com/docs/oidc
DiscoveryEndpoints__PrivacyPolicy=https://auth.example.com/policy
DiscoveryEndpoints__TermsOfService=https://auth.example.com/terms
